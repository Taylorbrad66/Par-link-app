<body>
  <div id="app"></div>
  <div id="toast" class="toast" role="status" aria-live="polite"></div>
  <script>
const APP_KEY='parlink.v1';
const APP_VERSION='1.2';
const now=()=>new Date().toISOString();
const uid=()=>Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4);
const esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));

const defaultHoles=()=>Array.from({length:18},(_,i)=>({number:i+1,par:[4,4,3,5,4,3,4,5,4,4,4,3,5,4,3,4,5,4][i],si:[7,3,15,1,9,17,5,11,13,8,4,16,2,10,18,6,12,14][i],lat:null,lng:null}));
const initialState={
  view:'home',
  profile:{name:'Brad',handicap:18,officialHandicap:18,courseCredits:2,clubs:[
    {name:'Driver',carry:210},{name:'3 Wood',carry:190},{name:'5 Wood',carry:175},{name:'4 Iron',carry:165},{name:'5 Iron',carry:155},{name:'6 Iron',carry:145},{name:'7 Iron',carry:135},{name:'8 Iron',carry:125},{name:'9 Iron',carry:115},{name:'PW',carry:100},{name:'SW',carry:80}
  ]},
  players:[
    {id:'brad',name:'Brad',handicap:18},{id:'paul',name:'Paul',handicap:18},{id:'andrew',name:'Andrew',handicap:18},{id:'wayne',name:'Wayne',handicap:18}
  ],
  courses:[{id:'demo',name:'ParLink Demo Course',location:'Demo only',activated:true,isDemo:true,scratchRating:72,slopeRating:113,pcc:0,holes:defaultHoles(),createdAt:now()}],
  rounds:[],activeRound:null,
  gpsPlus:false
};
let state=load();
let modal=null;
let gpsWatchId=null;
let gpsPosition=null;

function load(){
  try{const v=JSON.parse(localStorage.getItem(APP_KEY));return v?mergeDefaults(v):structuredClone(initialState)}catch{return structuredClone(initialState)}
}
function mergeDefaults(v){
  const merged={...structuredClone(initialState),...v,profile:{...initialState.profile,...(v.profile||{})},players:v.players?.length?v.players:structuredClone(initialState.players),courses:v.courses?.length?v.courses:structuredClone(initialState.courses),rounds:v.rounds||[]};
  if(merged.profile.officialHandicap==null)merged.profile.officialHandicap=Number(merged.profile.handicap||0);
  merged.courses=merged.courses.map(c=>({...c,scratchRating:Number(c.scratchRating??parTotalSafe(c)),slopeRating:Number(c.slopeRating??113),pcc:Number(c.pcc??0)}));
  return merged;
}
function parTotalSafe(course){return (course?.holes||[]).reduce((a,h)=>a+Number(h.par||0),0)||72}

function save(){localStorage.setItem(APP_KEY,JSON.stringify(state))}
function setView(v){state.view=v;save();render();window.scrollTo({top:0,behavior:'smooth'})}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1800)}
function initials(name){return name.split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase()}
function fmtDate(s){return new Date(s).toLocaleDateString(undefined,{day:'numeric',month:'short',year:'numeric'})}
function courseById(id){return state.courses.find(c=>c.id===id)}
function playerById(id){return state.players.find(p=>p.id===id)}
function activeCourses(){return state.courses.filter(c=>c.activated||c.isDemo)}
function activatedPaidCount(){return state.courses.filter(c=>c.activated&&!c.isDemo).length}
function creditsLeft(){return Math.max(0,(state.profile.courseCredits||2)-activatedPaidCount())}
function parTotal(course){return course.holes.reduce((a,h)=>a+Number(h.par||0),0)}
function round1(n){return Math.round((Number(n)+Number.EPSILON)*10)/10}
function handicapScoreCountRule(n){
  if(n<3)return {count:0,adjustment:0};
  if(n===3)return {count:1,adjustment:-2};
  if(n===4)return {count:1,adjustment:-1};
  if(n===5)return {count:1,adjustment:0};
  if(n===6)return {count:2,adjustment:-1};
  if(n<=8)return {count:2,adjustment:0};
  if(n<=11)return {count:3,adjustment:0};
  if(n<=14)return {count:4,adjustment:0};
  if(n<=16)return {count:5,adjustment:0};
  if(n<=18)return {count:6,adjustment:0};
  if(n===19)return {count:7,adjustment:0};
  return {count:8,adjustment:0};
}
function scoreDifferential(points,dailyHandicap,course){
  if(!course)return null;
  const par=parTotal(course),scratch=Number(course.scratchRating??par),slope=Number(course.slopeRating??113),pcc=Number(course.pcc??0);
  if(!Number.isFinite(slope)||slope<=0)return null;
  return round1(((36-Number(points||0))+Number(dailyHandicap||0)+par-(scratch+pcc))*(113/slope));
}
function handicapEntries(playerId='brad',rounds=state.rounds){
  return (rounds||[]).filter(r=>r.format!=='ambrose').map(r=>{
    const result=(r.results||[]).find(x=>x.playerId===playerId);if(!result)return null;
    const course=courseById(r.courseId)||{holes:Array.from({length:18},()=>({par:4})),scratchRating:r.scratchRating||72,slopeRating:r.slopeRating||113,pcc:r.pcc||0};
    let differential=result.scoreDifferential;
    if(differential==null){
      const hcp=result.handicapUsed??playerById(playerId)?.handicap??state.profile.officialHandicap??state.profile.handicap??0;
      differential=scoreDifferential(result.points,hcp,course);
    }
    return differential==null?null:{roundId:r.id,date:r.completedAt,courseName:r.courseName||course.name||'Course',differential:round1(differential)};
  }).filter(Boolean).slice(-20);
}
function estimateHandicap(playerId='brad',rounds=state.rounds){
  const entries=handicapEntries(playerId,rounds),n=entries.length,rule=handicapScoreCountRule(n);
  if(!rule.count)return {value:null,status:n?`${n} qualifying round${n===1?'':'s'} · need 3`:'Need 3 qualifying rounds',entries,used:[]};
  const sorted=[...entries].sort((a,b)=>a.differential-b.differential),used=sorted.slice(0,rule.count);
  const avg=used.reduce((a,x)=>a+x.differential,0)/used.length;
  const value=Math.min(54,round1(avg+rule.adjustment));
  return {value,status:`${n} qualifying rounds · lowest ${rule.count}${rule.adjustment?` · ${rule.adjustment.toFixed(1)} adjustment`:''}`,entries,used};
}
function handicapTrend(playerId='brad'){
  const all=state.rounds.filter(r=>r.format!=='ambrose'&&(r.results||[]).some(x=>x.playerId===playerId));
  return all.map((_,i)=>estimateHandicap(playerId,all.slice(0,i+1)).value).filter(v=>v!=null);
}
function handicapSparkline(values){
  if(!values?.length)return '';
  const w=300,h=84,p=8,min=Math.min(...values),max=Math.max(...values),span=Math.max(1,max-min);
  const pts=values.map((v,i)=>`${p+(i*(w-2*p)/Math.max(1,values.length-1))},${p+((v-min)/span)*(h-2*p)}`).join(' ');
  return `<svg class="hcp-chart" viewBox="0 0 ${w} ${h}" role="img" aria-label="Estimated handicap trend"><polyline points="${pts}" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
}

function nav(){
  const items=[['home','⌂','Home'],['play','⛳','Golf'],['stats','▥','Stats'],['mates','♟','Mates'],['profile','●','Profile']];
  return `<nav class="bottom-nav"><div class="nav-inner">${items.map(([v,i,l])=>`<button class="nav-btn ${state.view===v?'active':''}" data-nav="${v}"><span>${i}</span><span>${l}</span></button>`).join('')}</div></nav>`;
}
function header(title='ParLink'){
  return `<header class="header"><div class="brand"><div class="brand-mark">PL</div><div>${esc(title)}</div></div><div class="header-actions"><button class="icon-btn" data-action="install">＋</button></div></header>`;
}
function shell(content,title='ParLink'){return `<main class="shell">${header(title)}${content}</main>${nav()}`}

function homeView(){
  const last=state.rounds.at(-1);
  const best=bestRound();
  const hcp=estimateHandicap('brad');
  return shell(`
    <section class="hero"><div class="eyebrow">ParLink V1.2</div><h1>Know your game.<br>Beat your mates.<br>Beat yourself.</h1><p>Score rounds, build your stats, challenge a phantom and get simple club advice without a compulsory subscription.</p></section>
    <div class="grid">
      <button class="card" data-go="play"><div class="emoji">⛳</div><h3>Play</h3><p>Stroke, Stableford and Ambrose.</p></button>
      <button class="card" data-go="phantom"><div class="emoji">👻</div><h3>Phantom</h3><p>Play against your best or last round.</p></button>
      <button class="card" data-go="mates"><div class="emoji">🏆</div><h3>Compete</h3><p>Mates, winners and round history.</p></button>
