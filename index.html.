  `,'Caddie');
}
function caddieRecommendation(distance){const clubs=[...state.profile.clubs].sort((a,b)=>a.carry-b.carry);if(!clubs.length)return'<div class="empty">Add club distances in Profile.</div>';const nearest=clubs.reduce((a,b)=>Math.abs(b.carry-distance)<Math.abs(a.carry-distance)?b:a);const safe=clubs.find(c=>c.carry>=distance)||clubs.at(-1);return `<div class="caddie-card"><div class="eyebrow">Recommended</div><div class="club-rec">${esc(nearest.name)}</div><div>${nearest.carry} m normal carry · target ${distance} m</div><hr><div class="small"><strong>Safe option:</strong> ${esc(safe.name)} (${safe.carry} m). V1 deliberately keeps the advice simple. Wind, lie, hazards and dispersion are reserved for GPS+ / Caddie upgrades.</div></div>`}
function roundCaddie(){const r=state.activeRound,c=courseById(r.courseId),h=c.holes[r.hole-1],d=currentDistance(h);modal=`<div class="modal-backdrop" data-action="close-modal"><div class="modal" onclick="event.stopPropagation()"><div class="section-title"><h2>ParLink Caddie</h2><button class="icon-btn" data-action="close-modal">✕</button></div>${caddieRecommendation(d||135)}${!d?'<div class="callout warning" style="margin-top:12px">No green coordinate/GPS distance is available for this hole, so V1 is showing a 135 m example.</div>':''}</div></div>`;render()}

function statsView(){
  const rounds=state.rounds.slice().reverse();
  const total=rounds.length;const avg=total?Math.round(rounds.reduce((a,r)=>a+(r.results?.[0]?.gross||0),0)/total):0;
  const hcp=estimateHandicap('brad'),trend=handicapTrend('brad'),usedIds=new Set(hcp.used.map(x=>x.roundId));
  return shell(`
    <div class="section-title"><h2>Performance</h2><span>${total} completed rounds</span></div>
    <div class="kpis"><div class="kpi"><div class="value">${total}</div><div class="label">Rounds</div></div><div class="kpi"><div class="value">${avg||'—'}</div><div class="label">Avg gross*</div></div><div class="kpi"><div class="value">${state.courses.length}</div><div class="label">Courses saved</div></div></div>
    <div class="small" style="margin-top:8px">*Average uses the leading result in each saved round.</div>
    <section class="section"><div class="section-title"><h2>ParLink Handicap</h2><span>GA-style estimate</span></div>
      <div class="handicap-card"><div><div class="eyebrow">Estimated handicap</div><div class="hcp-big">${hcp.value==null?'—':hcp.value.toFixed(1)}</div><div class="small">Official / entered: ${Number(state.profile.officialHandicap??state.profile.handicap??0).toFixed(1)}</div></div><div class="hcp-trend">${handicapSparkline(trend)}<div class="small">${esc(hcp.status)}</div></div></div>
      <div class="callout warning" style="margin-top:10px"><strong>Estimate only.</strong> ParLink is not connected to GOLF Link. It uses saved ParLink rounds, Scratch Rating, Slope Rating and PCC data. Official cap and exceptional-score adjustments are not applied.</div>
    </section>
    <section class="section"><div class="section-title"><h2>Score differentials</h2><span>Most recent 20</span></div>${hcp.entries.length?`<div class="list">${[...hcp.entries].reverse().map(x=>`<div class="list-item"><div><strong>${esc(x.courseName)}</strong><div class="meta">${fmtDate(x.date)}${usedIds.has(x.roundId)?' · counting':''}</div></div><span class="badge ${usedIds.has(x.roundId)?'':'blue'}">${x.differential.toFixed(1)}</span></div>`).join('')}</div>`:`<div class="empty">Complete at least 3 individual rounds on courses with rating data to generate a ParLink handicap estimate.</div>`}</section>
    <section class="section"><div class="section-title"><h2>Round history</h2><span>Newest first</span></div>${rounds.length?`<div class="list">${rounds.map(roundCard).join('')}</div>`:`<div class="empty">No completed rounds yet.</div>`}</section>
  `,'Stats');
}

function matesView(){
  const wins={};state.players.forEach(p=>wins[p.id]=0);state.rounds.forEach(r=>{const w=r.results?.[0]?.playerId;if(w)wins[w]=(wins[w]||0)+1});
  const ladder=[...state.players].sort((a,b)=>(wins[b.id]||0)-(wins[a.id]||0));
  return shell(`
    <div class="section-title"><h2>Mates ladder</h2><span>Wins from saved rounds</span></div>
    <div class="list">${ladder.map((p,i)=>`<div class="list-item"><div class="score-main"><div class="avatar">${i+1}</div><div><strong>${esc(p.name)}</strong><div class="meta">HCP ${p.handicap}</div></div></div><span class="badge ${i===0?'':'blue'}">${wins[p.id]||0} win${wins[p.id]===1?'':'s'}</span></div>`).join('')}</div>
    <section class="section"><button class="btn btn-secondary" data-action="edit-players">Edit players</button></section>
  `,'Mates');
}

function profileView(){
  return shell(`
    <div class="form-card"><div class="section-title"><h2>Profile</h2><span>Stored on device</span></div>
      <div class="field"><label>Name</label><input id="profile-name" value="${esc(state.profile.name)}"></div>
      <div class="field"><label>Official / entered handicap</label><input id="profile-hcp" type="number" min="0" max="54" step="0.1" value="${state.profile.officialHandicap??state.profile.handicap}"></div>
      <button class="btn btn-primary" data-action="save-profile">Save profile</button>
      <div class="small" style="margin-top:10px">This is your official or manually entered handicap. ParLink keeps its calculated estimate separate.</div>
    </div>
    <section class="section"><div class="section-title"><h2>Handicap tracking</h2><span>ParLink estimate</span></div>${(()=>{const h=estimateHandicap('brad');return `<div class="list-item"><div><strong>${h.value==null?'Not enough rounds':h.value.toFixed(1)}</strong><div class="meta">${esc(h.status)}</div></div><button class="btn btn-secondary" data-nav="stats">View details</button></div>`})()}</section>
    <section class="section"><div class="section-title"><h2>Club distances</h2><span>Carry metres</span></div><div class="list">${state.profile.clubs.map((c,i)=>`<div class="list-item"><input class="club-name" data-i="${i}" value="${esc(c.name)}" style="max-width:150px"><input class="club-carry" data-i="${i}" type="number" value="${c.carry}" style="max-width:100px"></div>`).join('')}</div><div class="btn-row" style="margin-top:10px"><button class="btn btn-primary" data-action="save-clubs">Save clubs</button><button class="btn btn-secondary" data-action="add-club">＋ Add club</button></div></section>
    <section class="section"><div class="section-title"><h2>Course plan</h2><span>${creditsLeft()} credits left</span></div><div class="callout"><strong>2 course credits included.</strong> Demo courses do not consume a credit. Activating a user-added course uses one credit in this V1 prototype.</div></section>
    <section class="section"><div class="section-title"><h2>GPS+</h2><span>Prototype switch</span></div><div class="list-item"><div><strong>GPS+ access</strong><div class="meta">Future paid plan for unlimited courses and richer GPS.</div></div><button class="btn ${state.gpsPlus?'btn-primary':'btn-secondary'}" data-action="toggle-gpsplus">${state.gpsPlus?'Enabled':'Enable demo'}</button></div></section>
    <section class="section"><button class="btn btn-danger" data-action="reset-app">Reset all ParLink V1.2 data</button></section>
  `,'Profile');
}

function newCourseModal(){
  modal=`<div class="modal-backdrop" data-action="close-modal"><div class="modal" onclick="event.stopPropagation()"><div class="section-title"><h2>Add course</h2><button class="icon-btn" data-action="close-modal">✕</button></div><div class="field"><label>Course name</label><input id="course-name" placeholder="e.g. My Golf Club"></div><div class="field"><label>Location</label><input id="course-location" placeholder="Town / region"></div><div class="course-rating-grid"><div class="field"><label>Scratch Rating</label><input id="course-scratch" type="number" step="0.1" value="72"></div><div class="field"><label>Slope Rating</label><input id="course-slope" type="number" min="55" max="155" value="113"></div><div class="field"><label>PCC</label><input id="course-pcc" type="number" min="-1" max="3" step="1" value="0"></div></div><div class="small">Rating data is used for the ParLink handicap estimate. Set par, stroke index and optional green-centre coordinates below.</div><div style="margin-top:12px">${defaultHoles().map(h=>`<div class="course-hole"><div class="num">${h.number}</div><input data-hole-par="${h.number}" type="number" min="3" max="6" value="${h.par}" title="Par"><input data-hole-si="${h.number}" type="number" min="1" max="18" value="${h.si}" title="Stroke index"><button class="btn btn-secondary" data-set-green="${h.number}">GPS</button></div>`).join('')}</div><button class="btn btn-primary" style="width:100%;margin-top:10px" data-action="save-course">Save course</button></div></div>`;render();
}
function saveCourse(){const name=document.getElementById('course-name')?.value.trim();if(!name)return toast('Enter a course name');const holes=defaultHoles().map(h=>({...h,par:Number(document.querySelector(`[data-hole-par="${h.number}"]`)?.value||h.par),si:Number(document.querySelector(`[data-hole-si="${h.number}"]`)?.value||h.si),lat:null,lng:null}));const pending=window.__pendingGreens||{};holes.forEach(h=>{if(pending[h.number]){h.lat=pending[h.number].lat;h.lng=pending[h.number].lng}});state.courses.push({id:uid(),name,location:document.getElementById('course-location')?.value.trim()||'',activated:false,isDemo:false,scratchRating:Number(document.getElementById('course-scratch')?.value||parTotal({holes})),slopeRating:Number(document.getElementById('course-slope')?.value||113),pcc:Number(document.getElementById('course-pcc')?.value||0),holes,createdAt:now()});window.__pendingGreens={};modal=null;save();render();toast('Course added. Activate it with a course credit.')}
function setGreenFromGps(holeNum){if(!navigator.geolocation)return toast('GPS not supported on this device');navigator.geolocation.getCurrentPosition(p=>{window.__pendingGreens=window.__pendingGreens||{};window.__pendingGreens[holeNum]={lat:p.coords.latitude,lng:p.coords.longitude};toast(`Hole ${holeNum} green position saved`)},()=>toast('Could not get GPS position'),{enableHighAccuracy:true,timeout:10000})}
function activateCourse(id){const c=courseById(id);if(!c||c.activated)return;if(creditsLeft()<=0)return toast('No course credits remaining');c.activated=true;save();render();toast(`${c.name} activated`)}
function importCourse(){const input=document.createElement('input');input.type='file';input.accept='.json,application/json';input.onchange=async()=>{try{const data=JSON.parse(await input.files[0].text());if(!data.name||!Array.isArray(data.holes)||data.holes.length!==18)throw new Error();state.courses.push({id:uid(),name:data.name,location:data.location||'',activated:false,isDemo:false,scratchRating:Number(data.scratchRating??data.courseRating??72),slopeRating:Number(data.slopeRating??113),pcc:Number(data.pcc??0),holes:data.holes.map((h,i)=>({number:i+1,par:Number(h.par||4),si:Number(h.si||i+1),lat:h.lat??null,lng:h.lng??null})),createdAt:now()});save();render();toast('Course imported')}catch{toast('Invalid course JSON')}};input.click()}

function editPlayersModal(){modal=`<div class="modal-backdrop" data-action="close-modal"><div class="modal" onclick="event.stopPropagation()"><div class="section-title"><h2>Edit players</h2><button class="icon-btn" data-action="close-modal">✕</button></div>${state.players.map((p,i)=>`<div class="list-item"><input data-pname="${i}" value="${esc(p.name)}"><input data-phcp="${i}" type="number" min="0" max="54" value="${p.handicap}" style="max-width:90px"></div>`).join('')}<button class="btn btn-primary" style="width:100%;margin-top:12px" data-action="save-players">Save players</button></div></div>`;render()}
function savePlayers(){state.players=state.players.map((p,i)=>({...p,name:document.querySelector(`[data-pname="${i}"]`).value.trim()||p.name,handicap:Number(document.querySelector(`[data-phcp="${i}"]`).value||0)}));state.players.forEach(p=>{if(p.id==='brad'){state.profile.name=p.name;state.profile.handicap=p.handicap;state.profile.officialHandicap=p.handicap}});modal=null;save();render();toast('Players updated')}

function enableGps(){if(!navigator.geolocation)return toast('GPS not supported');if(gpsWatchId!=null){navigator.geolocation.clearWatch(gpsWatchId);gpsWatchId=null;gpsPosition=null;toast('GPS stopped');render();return}gpsWatchId=navigator.geolocation.watchPosition(p=>{gpsPosition={latitude:p.coords.latitude,longitude:p.coords.longitude,accuracy:p.coords.accuracy};render()},()=>toast('GPS permission denied'),{enableHighAccuracy:true,maximumAge:3000,timeout:15000});toast('GPS enabled')}

function render(){
  let html;
  switch(state.view){case'play':html=playView();break;case'phantom':html=phantomView();break;case'caddie':html=caddieView();break;case'stats':html=statsView();break;case'mates':html=matesView();break;case'profile':html=profileView();break;default:html=homeView()}
  document.getElementById('app').innerHTML=html+(modal||'');
  bind();
}
function bind(){
  document.querySelectorAll('[data-nav]').forEach(b=>b.onclick=()=>setView(b.dataset.nav));
  document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>setView(b.dataset.go));
  document.querySelectorAll('[data-format]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-format]').forEach(x=>x.classList.remove('active'));b.classList.add('active')});
  document.querySelectorAll('[data-player-select]').forEach(b=>b.onclick=()=>b.classList.toggle('active'));
  document.querySelectorAll('[data-score]').forEach(b=>b.onclick=()=>changeScore(b.dataset.score,Number(b.dataset.delta)));
  document.querySelectorAll('[data-activate-course]').forEach(b=>b.onclick=()=>activateCourse(b.dataset.activateCourse));
  document.querySelectorAll('[data-phantom]').forEach(b=>b.onclick=()=>{state.activeRound.phantomRoundId=b.dataset.phantom;modal=null;save();render();toast('Phantom enabled')});
  document.querySelectorAll('[data-set-green]').forEach(b=>b.onclick=()=>setGreenFromGps(Number(b.dataset.setGreen)));
  document.querySelectorAll('[data-share-round]').forEach(b=>b.onclick=()=>openShareRound(b.dataset.shareRound));
  document.querySelectorAll('[data-action]').forEach(b=>b.onclick=(e)=>{const a=b.dataset.action;actions[a]?.(e)});
}
const actions={
  'start-round':startRound,'prev-hole':prevHole,'next-hole':nextHole,'finish-round':finishRound,
  'abandon-round':()=>{if(confirm('Abandon this round?')){state.activeRound=null;save();render()}},
  'gps':enableGps,'enable-phantom':enablePhantom,'round-caddie':roundCaddie,
  'close-modal':()=>{modal=null;render()},'new-course':newCourseModal,'save-course':saveCourse,'import-course':importCourse,
  'edit-players':editPlayersModal,'save-players':savePlayers,
  'save-profile':()=>{state.profile.name=document.getElementById('profile-name').value.trim()||state.profile.name;state.profile.officialHandicap=Number(document.getElementById('profile-hcp').value||0);state.profile.handicap=Math.round(state.profile.officialHandicap);const p=state.players.find(x=>x.id==='brad');if(p){p.name=state.profile.name;p.handicap=state.profile.handicap}save();toast('Profile saved')},
  'save-clubs':()=>{state.profile.clubs=state.profile.clubs.map((c,i)=>({name:document.querySelector(`.club-name[data-i="${i}"]`).value.trim()||c.name,carry:Number(document.querySelector(`.club-carry[data-i="${i}"]`).value||0)}));save();toast('Club distances saved')},
  'add-club':()=>{state.profile.clubs.push({name:'New club',carry:100});save();render()},
  'caddie-recommend':()=>{const d=Number(document.getElementById('caddie-distance').value||0);document.getElementById('caddie-result').innerHTML=caddieRecommendation(d)},
  'toggle-gpsplus':()=>{state.gpsPlus=!state.gpsPlus;save();render();toast(state.gpsPlus?'GPS+ demo enabled':'GPS+ demo disabled')},
  'share-native':shareNative,'save-share-card':saveShareCard,'copy-share-text':copyShareText,
  'reset-app':()=>{if(confirm('Delete all ParLink V1.2 data on this device?')){localStorage.removeItem(APP_KEY);state=structuredClone(initialState);render();toast('ParLink reset')}},
  'install':async()=>{if(window.__deferredPrompt){window.__deferredPrompt.prompt();await window.__deferredPrompt.userChoice;window.__deferredPrompt=null}else toast('Use your browser menu → Add to Home screen')}
};

window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();window.__deferredPrompt=e});
// Service worker disabled in native Android wrapper; assets are bundled offline.
render();

// Register ParLink service worker for installed/PWA updates.
if ('serviceWorker' in navigator) {
  window.addEventListener('load', async () => {
    try {
      const regs = await navigator.serviceWorker.getRegistrations();
      for (const reg of regs) await reg.unregister();
      if ('caches' in window) {
        const keys = await caches.keys();
        await Promise.all(keys.map(k => caches.delete(k)));
      }
    } catch (_) {}
  });
}

  </script>
</body>
</html>
