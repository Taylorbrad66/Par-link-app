.eyebrow{color:var(--green);font-size:.78rem;text-transform:uppercase;letter-spacing:.16em;font-weight:800}.hero h1{font-size:2rem;line-height:1.05;margin:8px 0 10px}.hero p{margin:0;color:var(--muted);line-height:1.5}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}.card{border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:var(--radius);padding:16px;text-align:left;box-shadow:0 10px 24px rgba(0,0,0,.18)}.card:hover{border-color:#3f5b52}.card .emoji{font-size:1.5rem}.card h3{margin:9px 0 4px}.card p{margin:0;color:var(--muted);font-size:.9rem;line-height:1.35}
.section{margin-top:22px}.section-title{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:10px}.section-title h2{font-size:1.05rem;margin:0}.section-title span{color:var(--muted);font-size:.84rem}
.btn{border:0;border-radius:13px;padding:12px 14px;font-weight:800}.btn-primary{background:var(--green);color:#082016}.btn-secondary{background:var(--panel2);color:var(--text);border:1px solid var(--line)}.btn-danger{background:rgba(255,125,125,.12);color:#ffb6b6;border:1px solid rgba(255,125,125,.35)}.btn-row{display:flex;gap:10px;flex-wrap:wrap}.btn:disabled{opacity:.45;cursor:not-allowed}
.list{display:flex;flex-direction:column;gap:10px}.list-item{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid var(--line);background:var(--panel);border-radius:15px;padding:13px}.list-item .meta{color:var(--muted);font-size:.84rem;margin-top:3px}.badge{display:inline-flex;align-items:center;border-radius:999px;padding:5px 8px;font-size:.75rem;font-weight:800;background:rgba(105,228,159,.12);color:var(--green);border:1px solid rgba(105,228,159,.22)}.badge.blue{background:rgba(121,169,255,.12);color:#a8c6ff;border-color:rgba(121,169,255,.22)}.badge.amber{background:rgba(255,201,104,.12);color:#ffd995;border-color:rgba(255,201,104,.22)}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;background:rgba(8,17,15,.94);backdrop-filter:blur(16px);border-top:1px solid var(--line);z-index:10}.nav-inner{max-width:760px;margin:0 auto;display:grid;grid-template-columns:repeat(5,1fr);padding:8px 8px calc(8px + env(safe-area-inset-bottom))}.nav-btn{background:transparent;border:0;color:var(--muted);font-size:.72rem;padding:6px 3px;display:flex;flex-direction:column;gap:3px;align-items:center}.nav-btn span:first-child{font-size:1.15rem}.nav-btn.active{color:var(--green);font-weight:800}
.form-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px}.field{display:flex;flex-direction:column;gap:7px;margin-bottom:14px}.field label{font-size:.84rem;color:var(--muted);font-weight:700}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:12px;padding:12px;background:#0a1512;color:var(--text);outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--green2)}
.segmented{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.seg{border:1px solid var(--line);background:#0a1512;color:var(--muted);padding:10px;border-radius:12px;font-weight:800}.seg.active{background:rgba(105,228,159,.12);color:var(--green);border-color:rgba(105,228,159,.45)}
.player-pills{display:flex;flex-wrap:wrap;gap:8px}.pill{border:1px solid var(--line);border-radius:999px;padding:8px 10px;background:#0a1512;color:var(--muted)}.pill.active{color:#071b12;background:var(--green);border-color:var(--green)}
.round-head{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:start}.hole-info h1{margin:4px 0}.hole-info .sub{color:var(--muted)}.gps-box{border:1px solid var(--line);background:var(--panel);border-radius:15px;padding:12px;text-align:right;min-width:112px}.gps-number{font-size:1.6rem;font-weight:900}.gps-label{font-size:.72rem;color:var(--muted)}
.scoreboard{margin-top:14px;display:flex;flex-direction:column;gap:10px}.score-row{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;border:1px solid var(--line);background:var(--panel);border-radius:17px;padding:13px}.score-main{display:flex;align-items:center;gap:10px}.avatar{width:38px;height:38px;border-radius:50%;background:var(--panel2);display:grid;place-items:center;font-weight:900;color:var(--green)}.score-name{font-weight:800}.score-meta{font-size:.8rem;color:var(--muted);margin-top:2px}.stepper{display:flex;align-items:center;gap:8px}.stepper button{width:36px;height:36px;border-radius:11px;border:1px solid var(--line);background:#0a1512;color:var(--text);font-size:1.15rem}.score-value{min-width:30px;text-align:center;font-size:1.2rem;font-weight:900}
.hole-nav{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.progress{height:6px;border-radius:999px;background:#14231f;overflow:hidden;margin:12px 0}.progress > span{display:block;height:100%;background:var(--green)}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.kpi{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:12px}.kpi .value{font-size:1.45rem;font-weight:900}.kpi .label{color:var(--muted);font-size:.75rem;margin-top:2px}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:15px}.table{width:100%;border-collapse:collapse;min-width:560px;background:var(--panel)}.table th,.table td{padding:10px;border-bottom:1px solid var(--line);text-align:left;font-size:.84rem}.table th{color:var(--muted);font-weight:800;background:#0c1714}.table tr:last-child td{border-bottom:0}
.callout{border:1px solid rgba(105,228,159,.28);background:rgba(105,228,159,.08);border-radius:16px;padding:14px;color:#dff8e9}.callout strong{color:var(--green)}.warning{border-color:rgba(255,201,104,.28);background:rgba(255,201,104,.08);color:#ffe8ba}.danger{border-color:rgba(255,125,125,.3);background:rgba(255,125,125,.08);color:#ffd0d0}
.course-hole{display:grid;grid-template-columns:50px 1fr 1fr 1fr;gap:8px;align-items:center;margin-bottom:8px}.course-hole input{padding:9px}.course-hole .num{font-weight:900;color:var(--green)}
.caddie-card{background:linear-gradient(155deg,rgba(105,228,159,.15),rgba(121,169,255,.06)),var(--panel);border:1px solid rgba(105,228,159,.3);border-radius:22px;padding:18px}.club-rec{font-size:2rem;font-weight:950;margin:5px 0}.small{font-size:.82rem;color:var(--muted);line-height:1.4}
.empty{text-align:center;padding:30px 18px;color:var(--muted);border:1px dashed var(--line);border-radius:16px}.toast{position:fixed;left:50%;bottom:92px;transform:translate(-50%,20px);background:#f3f7f5;color:#07130f;padding:10px 14px;border-radius:999px;font-weight:800;opacity:0;pointer-events:none;transition:.2s;z-index:30;box-shadow:var(--shadow)}.toast.show{opacity:1;transform:translate(-50%,0)}
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.65);display:grid;place-items:end center;z-index:50}.modal{width:min(760px,100%);max-height:88vh;overflow:auto;background:var(--bg);border:1px solid var(--line);border-radius:24px 24px 0 0;padding:18px 16px calc(18px + env(safe-area-inset-bottom));box-shadow:0 -20px 60px rgba(0,0,0,.4)}
hr{border:0;border-top:1px solid var(--line);margin:18px 0}
@media (max-width:480px){.shell{padding:12px}.hero h1{font-size:1.7rem}.grid{grid-template-columns:1fr 1fr}.kpis{grid-template-columns:1fr 1fr}.course-hole{grid-template-columns:42px 1fr 1fr 1fr}.card{padding:14px}}

