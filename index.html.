.round-history-item{align-items:flex-start}.round-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}.share-mini{border:1px solid rgba(105,228,159,.3);background:rgba(105,228,159,.08);color:var(--green);border-radius:999px;padding:6px 9px;font-size:.75rem;font-weight:850}
.share-preview-card{background:radial-gradient(circle at 15% 0%,rgba(105,228,159,.19),transparent 40%),linear-gradient(155deg,#0e201a,#08110f 70%);border:1px solid rgba(105,228,159,.28);border-radius:24px;padding:20px;box-shadow:var(--shadow);overflow:hidden}.share-brand{display:flex;align-items:center;gap:10px;font-weight:950;letter-spacing:.08em}.share-logo{width:44px;height:44px;border-radius:13px;background:linear-gradient(145deg,var(--green),var(--green2));display:grid;place-items:center;color:#052216;letter-spacing:0}.share-kicker{margin-top:24px;color:var(--green);font-size:.72rem;font-weight:900;letter-spacing:.16em}.share-course{font-size:1.15rem;font-weight:800;margin-top:7px}.share-winner{font-size:2.15rem;font-weight:950;margin-top:20px;line-height:1}.share-score{font-size:2.7rem;color:var(--green);font-weight:950;line-height:1.05;margin-top:8px}.share-format{color:var(--muted);font-size:.84rem;margin-top:8px}.share-places{display:flex;flex-direction:column;gap:6px;margin-top:18px}.share-place{display:grid;grid-template-columns:30px 1fr auto;gap:8px;align-items:center;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.055);border-radius:12px;padding:9px 10px}.share-place:first-child{background:rgba(105,228,159,.08);border-color:rgba(105,228,159,.18)}.share-place span{color:var(--green);font-weight:900}.share-place b{font-size:.84rem;color:#dff8e9}.share-tagline{border-top:1px solid var(--line);padding-top:14px;margin-top:18px;color:#dff8e9;font-weight:750;font-size:.82rem}.share-help{color:var(--muted);line-height:1.45;font-size:.84rem;margin:14px 2px}.share-buttons{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:8px}.share-buttons .btn{padding:11px 9px}
@media (max-width:480px){.share-buttons{grid-template-columns:1fr}.round-actions{max-width:120px}.share-winner{font-size:1.8rem}.share-score{font-size:2.25rem}}


/* V1.2 Handicap Tracking */
.handicap-card{display:grid;grid-template-columns:minmax(120px,.8fr) 1.4fr;gap:16px;align-items:center;background:radial-gradient(circle at 0 0,rgba(105,228,159,.14),transparent 48%),var(--panel);border:1px solid rgba(105,228,159,.27);border-radius:20px;padding:17px}.hcp-big{font-size:3.1rem;line-height:1;font-weight:950;color:var(--green);margin:5px 0 8px}.hcp-trend{color:var(--green);min-width:0}.hcp-chart{width:100%;height:84px;display:block;filter:drop-shadow(0 4px 10px rgba(105,228,159,.16));transform:scaleY(-1)}.hcp-impact{display:flex;flex-direction:column;gap:4px;border:1px solid rgba(105,228,159,.28);background:rgba(105,228,159,.08);border-radius:15px;padding:12px;margin-bottom:12px}.hcp-impact strong{color:var(--green)}.hcp-impact span{font-size:1.25rem;font-weight:900}.hcp-impact small{color:var(--muted)}.share-hcp{margin-top:12px;color:var(--green);font-weight:850;font-size:.88rem}.share-toggle{display:flex;align-items:flex-start;gap:9px;color:#dff8e9;font-size:.84rem;line-height:1.35;margin:12px 2px}.share-toggle input{accent-color:var(--green);width:18px;height:18px;flex:0 0 auto}.course-rating-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
@media (max-width:480px){.handicap-card{grid-template-columns:1fr}.course-rating-grid{grid-template-columns:1fr 1fr}.course-rating-grid .field:last-child{grid-column:1/-1}}

